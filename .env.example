# Copy this file to .env and fill it in.  NEVER commit .env.  NEVER paste a key into chat.
#
# ⚠ THESE MUST BE **SANDBOX** KEYS, NOT LIVE KEYS.
# Stripe's docs, verbatim: "Sandbox keys start with pk_test_ (publishable),
# rk_test_ (restricted), and sk_test_ (secret)."
#
# WHERE TO GET THEM — the bit that trips everyone up:
#   The API-keys page is PER ENVIRONMENT. If the account switcher (top-left) says
#   "Silamin" you are looking at LIVE keys and everything will read sk_live_ / rk_live_.
#   Switch the picker to **New business sandbox** FIRST, then Developers -> API keys.
#   Only then do the values start sk_test_.

# Developers -> API keys, with the SANDBOX selected. Starts sk_test_
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Not an API key — a per-endpoint webhook signing secret.
# Easiest: run `stripe listen --forward-to localhost:4242/webhook` and copy the whsec_ it prints.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Where this app is reachable. Account Links redirect back here.
# HTTP is fine in a sandbox; LIVE MODE REQUIRES HTTPS.
APP_URL=http://localhost:4242
PORT=4242

# Platform commission in basis points. 1000 = 10.00%.
# The platform pays Stripe's fee on destination charges, so config.ts refuses to
# boot below 200 (2%) — see README.
PLATFORM_FEE_BPS=1000

# Optional: an existing connected account to pull in on boot, so the first screen
# shows real state instead of an empty list. Leave blank to start clean.
SEED_ACCOUNT_ID=

# Charge currency for the demo checkout.
DEFAULT_CURRENCY=dkk
